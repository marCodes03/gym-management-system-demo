# Mad Max Gym Backend Environment Configuration (Example)
NODE_ENV=development
PORT=4600

# PostgreSQL 16 Connection (Docker service: mad_max_gym_db)
DB_HOST=localhost
DB_PORT=5435
DB_NAME=mad_max_gym
DB_USER=postgres
DB_PASSWORD=madmax_dev_2026
DATABASE_URL=postgresql://postgres:madmax_dev_2026@localhost:5435/mad_max_gym

# Security & Authentication
# Generate a strong secret (min 32 chars): node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_strong_64_char_hex_secret_before_starting
JWT_EXPIRES_IN=12h

# CORS Allowed Origin (React Vite Client)
CORS_ORIGIN=http://localhost:4601
